{
  "name": "backup-dev",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac dmg"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "fs-extra": "^11.3.2"
  },
  "build": {
    "appId": "com.thiago.backupdeveloper",
    "productName": "Backup Developer",
    "electronDownload": {
      "cache": "./electron-cache"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "artifactName": "BackupDeveloper-${version}.dmg",
      "backgroundColor": "#f5f5f5"
    }
  }
}
