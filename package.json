{
  "name": "backup-dev",
  "version": "1.2.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build:mac": "electron-builder --mac dmg",
    "gerar-dmg-local": "bash scripts/gerar-dmg-local.sh",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .js",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md,html}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,html}\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "png2icons": "^2.0.1",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "fs-extra": "^11.3.2"
  },
  "build": {
    "appId": "com.thiago.backupdeveloper",
    "productName": "Backup Developer",
    "electronDownload": {
      "cache": "./electron-cache"
    },
    "files": [
      "build/**/*",
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "src/**/*",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/app-icon.icns",
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "asarUnpack": [
      "**/*.node"
    ],
    "dmg": {
      "artifactName": "BackupDeveloper-${version}.dmg",
      "icon": "build/app-icon.icns",
      "backgroundColor": "#f5f5f5"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thiagosolstafir69",
        "repo": "th-backup-dev"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thiagosolstafir69/th-backup-dev.git"
  }
}
